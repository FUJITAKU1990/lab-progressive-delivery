#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "$0")/lab-common"
cd "$lab_repository_root"

./scripts/setup-lab
docker compose up --detach --build --wait
./scripts/seed-unleash

printf '\nLab 6 is ready:\n'
printf '  Stable:  http://localhost:3000/checkout\n'
printf '  Canary:  http://localhost:3001/checkout\n'
printf '  Traefik: http://localhost:8080/checkout\n'
printf '  Unleash: http://localhost:4242\n'
printf '\nRun ./scripts/show-credentials for the local Unleash login.\n'
