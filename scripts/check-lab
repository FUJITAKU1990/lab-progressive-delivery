#!/usr/bin/env bash

set -uo pipefail

source "$(dirname "$0")/lab-common"
cd "$lab_repository_root" || exit 1

failures=0
stack_attempted=false

cleanup() {
  if [[ "$stack_attempted" == true ]]; then
    ./scripts/flag-control off >/dev/null 2>&1 || true
    docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true
  fi
}
trap cleanup EXIT

record_failure() {
  printf 'FAIL: %s\n' "$1" >&2
  failures=$((failures + 1))
}

for command in curl docker node; do
  if ! command -v "$command" >/dev/null 2>&1; then
    record_failure "$command is not available; reopen this repository in its devcontainer"
  fi
done

if ! docker compose version >/dev/null 2>&1; then
  record_failure "Docker Compose is not available; reopen this repository in its devcontainer"
fi

if ((failures > 0)); then
  printf '\nLab check stopped because required tools are unavailable.\n' >&2
  exit 1
fi

flag_source_valid=false
if node - <<'NODE'
"use strict";

const Module = require("node:module");
const path = require("node:path");

const calls = {
  evaluations: [],
  providers: [],
  registrations: [],
};
let evaluationResult = false;
const fakeClient = {
  async getBooleanValue(...args) {
    calls.evaluations.push(args);
    return evaluationResult;
  },
};
const fakeOpenFeature = {
  getClient() {
    return fakeClient;
  },
  async setProviderAndWait(provider) {
    calls.registrations.push(provider);
  },
  async close() {},
};
class FakeUnleashProvider {
  constructor(config) {
    this.config = config;
    calls.providers.push(this);
  }
}

const originalLoad = Module._load;
Module._load = function load(request, parent, isMain) {
  if (request === "@openfeature/server-sdk") {
    return { OpenFeature: fakeOpenFeature };
  }
  if (request === "@unleash/openfeature-node-provider") {
    return { UnleashProvider: FakeUnleashProvider };
  }
  return originalLoad.call(this, request, parent, isMain);
};

process.env.UNLEASH_URL = "http://unleash.test/api/";
process.env.UNLEASH_SDK_TOKEN = "default:development.test-token";

(async () => {
  try {
    const flags = require(path.resolve("src/flag.js"));
    for (const name of ["initializeFlags", "getNewFlow"]) {
      if (typeof flags[name] !== "function") {
        throw new Error(`export an async ${name} function`);
      }
    }

    await flags.initializeFlags();
    if (
      calls.providers.length !== 1 ||
      calls.registrations.length !== 1 ||
      calls.registrations[0] !== calls.providers[0]
    ) {
      throw new Error("register one Unleash provider during startup");
    }

    const config = calls.providers[0].config;
    if (
      config?.url !== process.env.UNLEASH_URL ||
      config?.customHeaders?.Authorization !== process.env.UNLEASH_SDK_TOKEN
    ) {
      throw new Error("configure the provider from the supplied environment");
    }

    evaluationResult = false;
    const disabled = await flags.getNewFlow();
    evaluationResult = true;
    const enabled = await flags.getNewFlow();
    if (disabled !== false || enabled !== true) {
      throw new Error("return the OpenFeature client's boolean result");
    }
    if (calls.providers.length !== 1) {
      throw new Error("do not create a new provider while evaluating a request");
    }
    if (calls.evaluations.length !== 2) {
      throw new Error("evaluate the flag once for each getNewFlow call");
    }
    for (const args of calls.evaluations) {
      if (args[0] !== "lab06-new-flow" || args[1] !== false) {
        throw new Error("evaluate lab06-new-flow with the boolean default false");
      }
    }
  } catch (error) {
    console.error(error.message);
    process.exit(1);
  } finally {
    Module._load = originalLoad;
  }
})();
NODE
then
  flag_source_valid=true
else
  record_failure "src/flag.js does not connect the supplied flag through OpenFeature"
fi

# Skip the stateful stack when the starter integration is still incomplete.
if [[ "$flag_source_valid" == true ]]; then
  if ! ./scripts/setup-lab; then
    record_failure "local lab credentials could not be prepared"
  elif ! docker compose config --quiet; then
    record_failure "compose.yml or its generated environment files are invalid"
  else
    stack_attempted=true
    docker compose down --volumes --remove-orphans >/dev/null 2>&1 || true

    printf '\nStarting the pinned lab stack...\n'
    if ! docker compose up --detach --build --wait postgres unleash canary; then
      record_failure "Unleash and the canary did not become healthy"
    elif ! ./scripts/seed-unleash; then
      record_failure "the supplied Unleash flag could not be seeded"
    else
      canary_host=$(wait_for_lab_host 3001 /health 10 || true)
      if [[ -z "$canary_host" ]]; then
        record_failure "the running canary is not reachable from the devcontainer"
      else
        canary_url="http://${canary_host}:3001/checkout"

        response_matches() {
          local body=$1
          local expected_flag=$2
          node - "$body" "$expected_flag" <<'NODE'
"use strict";

try {
  const value = JSON.parse(process.argv[2]);
  const expectedFlag = process.argv[3] === "true";
  process.exit(
    value.version === "canary" && value.new_flow === expectedFlag ? 0 : 1,
  );
} catch {
  process.exit(1);
}
NODE
        }

        wait_for_checkout() {
          local expected_flag=$1
          local deadline=$((SECONDS + 20))
          local body

          while ((SECONDS < deadline)); do
            body=$(curl --noproxy '*' --fail --silent --max-time 2 \
              "$canary_url" 2>/dev/null || true)
            if response_matches "$body" "$expected_flag"; then
              return 0
            fi
            sleep 0.5
          done

          return 1
        }

        if ! wait_for_checkout false; then
          record_failure "the disabled flag did not produce new_flow: false"
        fi

        canary_id_before=$(docker compose ps --quiet canary)
        if ! ./scripts/flag-control on >/dev/null; then
          record_failure "the checker could not enable lab06-new-flow"
        elif ! wait_for_checkout true; then
          record_failure "the running canary did not observe the enabled flag"
        else
          canary_id_after=$(docker compose ps --quiet canary)
          if [[ -z "$canary_id_before" || "$canary_id_before" != "$canary_id_after" ]]; then
            record_failure "the canary restarted while the flag changed"
          fi
        fi

        if ! ./scripts/flag-control off >/dev/null; then
          record_failure "the checker could not disable lab06-new-flow again"
        elif ! wait_for_checkout false; then
          record_failure "the running canary did not return to new_flow: false"
        fi
      fi
    fi
  fi
fi

if ((failures > 0)); then
  printf '\nLab check failed with %d problem(s).\n' "$failures" >&2
  exit 1
fi

printf '\nAll Lab 6 checks passed.\n'
