#!/usr/bin/env bash

set -euo pipefail

source "$(dirname "$0")/lab-common"
cd "$lab_repository_root"

./scripts/setup-lab
set -a
source .env
set +a

printf 'Unleash: http://localhost:4242\n'
printf 'Username: %s\n' "$UNLEASH_DEFAULT_ADMIN_USERNAME"
printf 'Password: %s\n' "$UNLEASH_DEFAULT_ADMIN_PASSWORD"
