{
  "name": "Feature Flags and Weighted Routing Lab",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false
    }
  },
  "forwardPorts": [3000, 3001, 4242, 8080],
  "portsAttributes": {
    "3000": {
      "label": "Stable app"
    },
    "3001": {
      "label": "Canary app"
    },
    "4242": {
      "label": "Unleash"
    },
    "8080": {
      "label": "Traefik"
    }
  },
  "postCreateCommand": "npm ci && ./scripts/setup-lab",
  "postStartCommand": "./scripts/start-lab"
}
